// ==========================================================
// Prisma Schema — Shop Inventory & Billing Management System
// Datasource: MongoDB
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------
// Enums
// ---------------------------

enum UserRole {
  ADMIN
  STAFF
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PAID
  DUE
  PARTIAL
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  OTHER
}

enum InvoiceStatus {
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AdjustmentType {
  RESTOCK
  DAMAGE
  LOSS
  CORRECTION
  SALE
  RETURN
}

// ---------------------------
// User & Auth (FR-1.x)
// ---------------------------
// User is the pure auth record (login credentials + role). Profile details
// live on Admin/Staff, one-to-one with User via a unique userId.

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  role      UserRole @default(STAFF)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin Admin?
  staff Staff?

  invoices         Invoice[]
  stockAdjustments StockAdjustment[]
}

model Admin {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String   @unique
  image         String?
  contactNumber String?
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique @db.ObjectId
}

model Staff {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String   @unique
  image         String?
  contactNumber String?
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique @db.ObjectId
}

// ---------------------------
// Category (FR-2.x)
// ---------------------------
// NOTE: the old direct `products Product[]` back-relation is removed —
// Product<->Category is now many-to-many via ProductCategory below.

model Category {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  parentCategoryId String?           @db.ObjectId
  parentCategory   Category?         @relation("CategoryToCategory", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subCategories    Category[]        @relation("CategoryToCategory")
  products         ProductCategory[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// ---------------------------
// Product (FR-3.x)
// ---------------------------

model Product {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  sku              String        @unique
  price            Float
  costPrice        Float         @default(0)
  taxRate          Float?        @default(0) // percentage, e.g. 5 = 5%
  reorderThreshold Int?          @default(5)
  unit             String        @default("pcs")
  thumbnailImage   String        @default("")
  description      String?
  status           ProductStatus @default(ACTIVE)

  categories ProductCategory[]
  variants   Variant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceItems     InvoiceItem[]
  stockAdjustments StockAdjustment[]

  @@index([name])
}

// Many-to-many join: one product can sit in multiple categories, and one
// category can hold many products.
model ProductCategory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  productId  String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Prevents the same product being linked to the same category twice.
  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

// A color variant of a product (e.g. "Red"), each with its own images and
// a set of sizes/stock.
model Variant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @db.ObjectId
  images    String[] @default([])
  color     String
  sizes     Size[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, color])
  @@index([productId])
}

model Size {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  variant   Variant  @relation(fields: [variantId], references: [id])
  variantId String   @db.ObjectId
  size      String
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, size])
  @@index([variantId])
}

// ---------------------------
// Customer (FR-6.x)
// ---------------------------

model Customer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  phone      String   @unique
  email      String?
  address    String?
  dueBalance Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  invoices Invoice[]
}

// ---------------------------
// Invoice / Billing (FR-5.x, FR-7.x)
// ---------------------------

model Invoice {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber  String        @unique
  customerId     String?       @db.ObjectId
  customer       Customer?     @relation(fields: [customerId], references: [id])
  customerName   String        @default("Walk-in Customer")
  userId         String        @db.ObjectId
  user           User          @relation(fields: [userId], references: [id])
  items          InvoiceItem[]
  subtotal       Float
  taxAmount      Float?        @default(0)
  discountAmount Float         @default(0)
  discountType   String        @default("FLAT") // FLAT | PERCENT
  totalAmount    Float
  paymentStatus  PaymentStatus @default(PAID)
  paymentMethod  PaymentMethod @default(CASH)
  status         InvoiceStatus @default(COMPLETED)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([customerId])
  @@index([userId])
  @@index([createdAt])
}

model InvoiceItem {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId   String  @db.ObjectId
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  productId   String  @db.ObjectId
  product     Product @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Float
  taxRate     Float?  @default(0)
  lineTotal   Float

  @@index([invoiceId])
  @@index([productId])
}

// ---------------------------
// Stock Adjustment / Audit Log (FR-4.x)
// ---------------------------

model StockAdjustment {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  productId String         @db.ObjectId
  product   Product        @relation(fields: [productId], references: [id])
  userId    String         @db.ObjectId
  user      User           @relation(fields: [userId], references: [id])
  changeQty Int // positive = stock increase, negative = decrease
  type      AdjustmentType
  reason    String
  createdAt DateTime       @default(now())

  @@index([productId])
  @@index([createdAt])
}
